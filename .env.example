# Copy to .env and fill in real values. NEVER commit .env to git.

# --- TYRES DB ---
TYRES_SERVICE_BASE_URL=http://tyres_service:8000
TYRES_DB_HOST=postgres_tyres
TYRES_DB_PORT=5432
TYRES_DB_NAME=tyre_db
TYRES_DB_USER=tyre_user
TYRES_DB_PASSWORD=<generate: openssl rand -hex 24>

# --- USERS DB ---
USERS_SERVICE_BASE_URL=http://users_service:8000
USERS_DB_HOST=postgres_users
USERS_DB_PORT=5432
USERS_DB_NAME=users_db
USERS_DB_USER=users_user
USERS_DB_PASSWORD=<generate: openssl rand -hex 24>

APP_ENV=docker

# --- ORDERS DB ---
ORDERS_SERVICE_BASE_URL=http://orders_service:8000
ORDERS_DB_HOST=postgres_orders
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=<generate: openssl rand -hex 24>

# --- RABBITMQ (self-hosted container; no external account needed) ---
RABBIT_USER=rabbit
RABBIT_PASSWORD=<generate: openssl rand -hex 24>

# --- PRICING ---
# Retail price = supplier cost * this markup (1.35 = 35% margin)
RETAIL_MARKUP=1.35

# --- AUTH ---
# Shared secret used to sign/verify JWTs across all services.
JWT_SECRET=<generate: openssl rand -hex 32>
# Access token lifetime in minutes (default 480 = one shift)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed browser origins for the APIs.
# Add http://<this-machine's-LAN-IP>:3000 if staff open the app
# from other devices on the shop network.
ALLOWED_ORIGINS=http://localhost:3000
